#%PAM-1.0
# Distribution packages may replace these includes with their canonical
# system-auth/common-auth stack. The login service is the portable baseline
# and preserves the host's authentication and account policy.
auth include login
# Vault re-unlock upon screen lock dismissal (sigil ADR-0001 / portal ADR-0020):
# pam_sigil passes the authentication token directly to sigil daemon via
# native memory Unix domain socket. Optional: authentication never depends
# on the module.
auth optional pam_sigil.so
account include login
session optional pam_sigil.so
