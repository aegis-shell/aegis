#%PAM-1.0
# Distribution packages may replace these includes with their canonical
# system-auth/common-auth stack. The login service is the portable baseline
# and preserves the host's authentication and account policy.
auth include login
# The vault-unlock token is planted by pam_aegis at the credential-commit
# hook: aegis-lock calls pam_setcred(PAM_ESTABLISH_CRED) after a successful
# authentication, and pam_sm_setcred (or pam_sm_open_session, whichever
# fires first) writes $XDG_RUNTIME_DIR/aegis-pam-token, mode 0600; the
# portal consumes and deletes it. Optional: authentication never depends
# on the module.
auth optional pam_aegis.so
account include login
session optional pam_aegis.so
