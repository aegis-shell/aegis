#!/bin/sh

# tessera-session: start the tessera compositor as a systemd user service so the
# graphical-session target, session slice, and cgroup delegation apply to the
# whole session. Modeled on niri-session(1); point the display manager or
# greeter at this script instead of the bare `tessera` binary.

# Detect if being run as a user service, which implies external session
# management: exec the compositor directly.
if [ -n "${MANAGERPID:-}" ] && [ "${SYSTEMD_EXEC_PID:-}" = "$$" ]; then
    case "$(ps -p "$MANAGERPID" -o cmd=)" in
    *systemd*--user*)
        exec tessera
        ;;
    esac
fi

# When started from a greeter, re-exec through the login shell first so
# profile environment (PATH, locale, proxies) reaches the systemd user
# manager below.
if [ -n "$SHELL" ] &&
    grep -q "$SHELL" /etc/shells &&
    ! (echo "$SHELL" | grep -q "false") &&
    ! (echo "$SHELL" | grep -q "nologin"); then
    if [ "$1" != '-l' ]; then
        exec bash -c "exec -l '$SHELL' -c 'exec $0 -l $@'"
    else
        shift
    fi
fi

if hash systemctl >/dev/null 2>&1; then
    # Make sure there's no already running session.
    if systemctl --user -q is-active tessera.service; then
        echo 'An tessera session is already running.'
        exit 1
    fi

    # Reset failed state of all user units.
    systemctl --user reset-failed

    # Import the login manager environment. systemd >= 256 deprecates
    # `import-environment` without an explicit variable list, so enumerate
    # the login environment names; values are read from this process.
    login_env_names=$(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')
    if [ -n "$login_env_names" ]; then
        # Word splitting is intended: each name is a separate argument.
        systemctl --user import-environment $login_env_names
    fi

    # DBus activation environment is independent from systemd. While most of
    # dbus-activated services are already using `SystemdService` directive,
    # some still don't and thus we should set the dbus environment with a
    # separate command.
    if hash dbus-update-activation-environment 2>/dev/null; then
        dbus-update-activation-environment --all
    fi

    # Start tessera and wait for it to terminate.
    systemctl --user --wait start tessera.service

    # Force stop of graphical-session.target.
    systemctl --user start --job-mode=replace-irreversibly tessera-shutdown.target

    # Unset environment that we've set.
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP
else
    echo "No systemd detected, please start tessera directly."
fi
